{
  "info": {
    "name": "Dune Shop API",
    "description": "Tests for the Dune Shop product REST API. Run in order. Set base_url, username, password (a STAFF account) and category_id (an existing category; seed_demo creates some) collection variables first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://YOUR-APP.onrender.com"
    },
    {
      "key": "username",
      "value": "your-username"
    },
    {
      "key": "password",
      "value": "your-password"
    },
    {
      "key": "category_id",
      "value": "1"
    },
    {
      "key": "product_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. GET list of products (public) - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Body is an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            ""
          ]
        }
      }
    },
    {
      "name": "2. POST create product without auth - 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthenticated write rejected with 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": {{category_id}},\n  \"name\": \"Postman Test Product\",\n  \"description\": \"Created from Postman\",\n  \"price\": \"19.99\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            ""
          ]
        }
      }
    },
    {
      "name": "3. POST create product (staff Basic auth) - 201",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 201', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Response has id', () => pm.expect(body.id).to.exist);",
              "pm.collectionVariables.set('product_id', body.id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"category\": {{category_id}},\n  \"name\": \"Postman Test Product\",\n  \"description\": \"Created from Postman\",\n  \"price\": \"19.99\",\n  \"stock\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            ""
          ]
        }
      }
    },
    {
      "name": "4. POST invalid data - 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"model_name\": \"Missing required fields\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            ""
          ]
        }
      }
    },
    {
      "name": "5. GET product detail - 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', () => pm.response.to.have.status(200));",
              "pm.test('Returns the created product', () => pm.expect(pm.response.json().model_name).to.eql('Postman Test Product'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/{{product_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{product_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "6. DELETE product without auth - 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthenticated delete rejected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/{{product_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{product_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "7. DELETE product (staff Basic auth) - 204",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "{{username}}",
              "type": "string"
            },
            {
              "key": "password",
              "value": "{{password}}",
              "type": "string"
            }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/{{product_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{product_id}}",
            ""
          ]
        }
      }
    },
    {
      "name": "8. GET deleted product - 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 404', () => pm.response.to.have.status(404));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/{{product_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{product_id}}",
            ""
          ]
        }
      }
    }
  ]
}